{
  "name": "Sample Tower Model",
  "inputShape": [3, 32, 32],
  "blocks": [
    {
      "id": "block1",
      "type": "ConvBlock",
      "params": {
        "in_channels": 3,
        "out_channels": 16,
        "kernel_size": 3,
        "stride": 1,
        "padding": 1
      },
      "activation": "relu"
    },
    {
      "id": "block2",
      "type": "ConvBlock",
      "params": {
        "in_channels": 16,
        "out_channels": 32,
        "kernel_size": 3,
        "stride": 1,
        "padding": 1
      },
      "activation": "relu"
    },
    {
      "id": "block3",
      "type": "SEBlock",
      "params": {
        "in_channels": 32,
        "reduction": 8
      }
    }
  ],
  "augmentations": [
    {
      "type": "RandomHorizontalFlip",
      "params": {
        "p": 0.5
      }
    },
    {
      "type": "RandomCrop",
      "params": {
        "size": 32,
        "padding": 4
      }
    }
  ]
}
